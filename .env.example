# ── ScholarSetu AI – Docker Environment Variables ────────────────────────────
# Copy this file to .env and fill in your values before running docker-compose
# cp .env.example .env

# ── Django ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
DEBUG=False

# ── Database ────────────────────────────────────────────────────────────────
DB_ENGINE=postgresql
POSTGRES_DB=scholarsetu_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-strong-postgres-password-here

# ── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:80
BACKEND_URL=http://localhost:8000
BACKEND_PORT=8000
FRONTEND_PORT=80

# ── Google OAuth (optional) ──────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ── Email (SMTP via Gmail) ───────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password-16-chars
DEFAULT_FROM_EMAIL=your-gmail@gmail.com

