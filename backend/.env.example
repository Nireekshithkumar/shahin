# ==============================================================================
# ScholarSetu AI - Production & Development Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control — it is listed in .gitignore.
# ==============================================================================

# Core Django Settings
SECRET_KEY=scholarsetu-django-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=*

# System URLs (Used in Email Templates & Unsubscribe Webhooks)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Database Configuration (Leave DB_ENGINE=sqlite for local development, or use postgresql)
DB_ENGINE=sqlite
POSTGRES_DB=scholarsetu_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Google OAuth (For Google Identity One-Tap & OAuth token verification)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ==============================================================================
# Email Configuration (SMTP)
# ==============================================================================
# The sender defaults to nireekshith9@gmail.com.
# You MUST set EMAIL_HOST_PASSWORD to a Gmail App Password (not the account password).
# Gmail App Password setup:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification if not already enabled.
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Generate an App Password for "Mail" / "Other (Custom name: ScholarSetu)".
#   5. Copy the 16-character code and paste it as EMAIL_HOST_PASSWORD below.
# To use a different sender, update EMAIL_HOST_USER and DEFAULT_FROM_EMAIL here.
# Restart the backend, Celery workers, and Celery Beat after changing these values.
# ==============================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=nireekahith@gmail.com
EMAIL_HOST_PASSWORD=replace_with_gmail_app_password
DEFAULT_FROM_EMAIL=nireekahith@gmail.com
EMAIL_TIMEOUT=15

# For local development, use console backend to see emails in terminal:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Background Tasks, Celery & Redis
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Site branding
SCHOLARSETU_SITE_NAME=ScholarSetu AI
